struct R { name: Str, xs: List<Int>, n: Int }
fn main() -> Str {
    let mut m: Map<Str, R> = Map::new();
    let a = R { name: "a" + "", xs: [1], n: 1 };
    m.insert(a.name, a);
    m.insert(a.name + "2", R { n: 2, ..a });
    m.insert("a", R { name: "A" + "", xs: [], n: 3 });
    let mut out = "";
    for k in m.keys() { let r = m.get(k).unwrap_or(R { name: "-", xs: [], n: 0 }); out = out + k + r.name + r.xs.len().to_str() + r.n.to_str(); }
    let mut hm: HashMap<Str, List<R>> = HashMap::new();
    hm.insert("l", [a, a]);
    let l = hm.get("l").unwrap_or([]);
    out + l.len().to_str() + l[1].name + a.name + a.xs.len().to_str() + m.len().to_str()
}
