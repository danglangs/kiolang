// The only hand-written declaration of what crosses the sandbox wall.
// The checker's capability table and the runtime's and host's Rust bindings are generated from this file.
// Changing it is a security-review event.

package kio:caps;

interface fs {
  variant io-err { not-found, denied, too-large, invalid-path, exists }

  // A directory the host opened. Paths are relative to it and cannot escape it.
  resource dir {
    read:   func(path: string) -> result<list<u8>, io-err>;
    create: func(path: string, data: list<u8>) -> result<_, io-err>;     // a new file only
    %list:  func(path: string) -> result<list<string>, io-err>;          // names, sorted; a directory's ends in `/`
    write:  func(path: string, data: list<u8>) -> result<_, io-err>;     // create or replace, atomically
    remove: func(path: string) -> result<_, io-err>;                     // one regular file
    exists: func(path: string) -> result<bool, io-err>;
  }
}

interface net {
  // `invalid`: a method that is not one of GET, HEAD, POST, PUT, PATCH, DELETE or OPTIONS, a header
  // without `: `, with CR or LF, or naming one the host sets (host, content-length, ..), over 64
  // headers or 8 KB each, or a batch of more than 64 requests. `status(n)` is `get`'s only.
  variant http-err { denied, timeout, too-large, status(u16), invalid }
  // Headers are `name: value`, one string each; response names are lowercased, in order.
  record http-response { status: u16, headers: list<string>, body: list<u8> }
  // One request of `send-all`. `timeout-ms` 0 means the grant's timeout; a larger value is capped at it.
  record http-request { method: string, path: string, headers: list<string>, body: list<u8>, timeout-ms: u32 }

  // One host the operator granted (`--http name=host`), GET only unless `--http-methods name=..`
  // adds methods. Redirects are followed for GET and HEAD only, each hop rechecked.
  resource http {
    get: func(path: string) -> result<list<u8>, http-err>;              // a non-2xx status is status(n)
    // A non-2xx status is ok (the program reads `status`); a method not granted is denied; the
    // body at most 8 MB (else too-large); the response as `get`'s limits.
    send: func(method: string, path: string, headers: list<string>, body: list<u8>) -> result<http-response, http-err>;
    // `reqs` issued at once, each checked, counted and audited as a `send`; results in list order
    // whatever finished first. At most 64 a batch, else every result is invalid and nothing is sent.
    send-all: func(reqs: list<http-request>) -> list<result<http-response, http-err>>;
  }
}

interface web {
  resource incoming {
    method: func() -> string;                 // "GET"
    target: func() -> string;                 // "/path?query" as sent, percent-encoding kept; no scheme, host or fragment
    header-names: func() -> list<string>;     // lowercased, in order
    header-values: func() -> list<string>;
    body: func() -> list<u8>;
  }
  resource outgoing {
    send: func(status: u16, header-names: list<string>, header-values: list<string>, body: list<u8>) -> result<_, web-err>;
  }
  variant web-err { already-sent, invalid }
}

interface kv {
  variant kv-err { too-large, full, not-int, overflow }
  record kv-entry { key: string, value: list<u8> }

  // A key-value store the host keeps across runs and requests. Keys are 1 to 1,024 bytes.
  resource kv {
    get:    func(key: string) -> result<option<list<u8>>, kv-err>;
    set:    func(key: string, value: list<u8>) -> result<_, kv-err>;
    delete: func(key: string) -> result<_, kv-err>;               // a missing key is not an error
    keys:   func(prefix: string) -> result<list<string>, kv-err>; // sorted by bytes
    // Set `key` to `new` (`none` deletes) only if its value is `old` (`none` = absent), atomically.
    swap:   func(key: string, old: option<list<u8>>, new: option<list<u8>>) -> result<bool, kv-err>;
    // The entries whose key starts with `prefix` and is greater than `after` (by bytes), in key
    // order, at most `limit` of them (1 to 1,000, else too-large; too-large past 8 MB in all).
    scan:   func(prefix: string, after: option<string>, limit: u32) -> result<list<kv-entry>, kv-err>;
    // Add `n` to the decimal integer stored at `key` (absent counts as 0), atomically; the new
    // value, stored as decimal text. Another value is not-int; past 64 bits is overflow.
    add:    func(key: string, n: s64) -> result<s64, kv-err>;
  }
}

interface ws {
  // One WebSocket event under `--listen`: a connection opened, a message arrived, or it closed.
  resource ws-message {
    kind: func() -> string;     // "open", "text", "binary", "close"
    conn: func() -> u64;        // connection id, unique per server run
    data: func() -> list<u8>;   // empty for open and close
    // The upgrade request's, the same for every event of the connection (WS1b).
    target: func() -> string;                      // "/path?query" as sent, percent-encoding kept
    header: func(name: string) -> option<string>;  // the first value; name in any case
  }
  // Sends on that connection, written in order after the run ends.
  resource ws-send {
    text:   func(s: string) -> result<_, ws-err>;
    binary: func(b: list<u8>) -> result<_, ws-err>;
    close:  func(code: u16) -> result<_, ws-err>;
  }
  variant ws-err { closed, too-large, invalid }
}

interface rng {
  // Randomness from the source the operator granted: the OS (`--rng name`), or a stream keyed by
  // a seed (`--rng name=seed:N`), the same every run; under `--listen`, by the seed and the
  // request number.
  resource rng {
    bytes: func(n: u32) -> list<u8>;       // n at most 65,536 (more is a runtime error at the call)
    int:   func(lo: s64, hi: s64) -> s64;  // uniform in lo..hi, no modulo bias; lo < hi (else a runtime error)
  }
}

interface clock {
  // The system clock (`--clock name`) or one fixed time (`--clock name=fixed:<ms>` or an RFC 3339 UTC time).
  resource clock {
    now-ms: func() -> s64;   // milliseconds since the Unix epoch
  }
}

interface log {
  variant log-err { too-large }

  // The program's own log (`--log name=path`, appended; `name=-` is stderr), not the audit log.
  // One line per call, control characters escaped; at most 64 KB a line and 1 MB a run.
  resource log {
    write: func(line: string) -> result<_, log-err>;
  }
}

interface db {
  // A SQL value: a column of a row, or a `?` parameter. A `float` NaN binds as NULL (SQLite's rule).
  variant sql-value { null, int(s64), float(f64), text(string), blob(list<u8>) }
  // invalid: bad SQL, two statements in one call, a wrong parameter count, with SQLite's message;
  // denied: a statement the host refuses (ATTACH, a PRAGMA, a transaction, a write on `:ro`);
  // busy: another process held the database past the timeout; too-large: a result over 10,000
  // rows or 8 MB, or a value past the limits; constraint: a constraint failed, with the message.
  variant db-err { invalid(string), denied, busy, too-large, constraint(string) }

  // One SQLite database the operator granted (`--db name=path`, `path:ro` or `:memory:`). One
  // statement per call; values reach SQL only as `?` parameters.
  resource db {
    query:       func(sql: string, params: list<sql-value>) -> result<list<list<sql-value>>, db-err>;  // rows, columns in SELECT order
    exec:        func(sql: string, params: list<sql-value>) -> result<s64, db-err>;                    // rows changed
    // Each statement with its own parameters, in one transaction: all or nothing; rows changed in all.
    transaction: func(sqls: list<string>, params: list<list<sql-value>>) -> result<s64, db-err>;
  }
}

interface hmac {
  // HMAC-SHA256 under a key the host read at start (`--hmac name=env:VAR|file:PATH[:verify]`).
  resource hmac {
    sign: func(msg: list<u8>) -> result<list<u8>, hmac-err>;   // 32 bytes
    verify: func(msg: list<u8>, mac: list<u8>) -> bool;        // constant time; any length
  }
  variant hmac-err { denied }                                  // `sign` under `:verify`
}

// Compiled kio (docs/codegen.md): the runtime with the program appended, one core module.
world compiled {
  import fs;
  import net;
  import web;
  import kv;
  import ws;
  import rng;
  import clock;
  import log;
  import db;
  import hmac;
  use fs.{dir};
  use net.{http};
  use web.{incoming, outgoing};
  use kv.{kv};
  use ws.{ws-message, ws-send};
  use rng.{rng};
  use clock.{clock};
  use log.{log};
  use db.{db};
  use hmac.{hmac};

  // One handle per capability parameter of `main`, in parameter order.
  variant grant {
    dir(dir), http(http), incoming(incoming), outgoing(outgoing), kv(kv), ws-message(ws-message), ws-send(ws-send),
    rng(rng), clock(clock), log(log), db(db), hmac(hmac),
  }
  // main's value printed, and whether main returned `Err`.
  record outcome { value: string, failed: bool }

  // A runtime error at error site `site`, with the values its message shows. Never returns:
  // the host records it and traps.
  import trap: func(site: u32, a: s64, b: s64);

  export run: func(grants: list<grant>) -> result<outcome>;
}
