// The only hand-written declaration of what crosses the sandbox wall.
// The checker's capability table and the guest and host Rust bindings are generated from this file.
// Changing it is a security-review event.

package kio:caps;

interface fs {
  variant io-err { not-found, denied, too-large, invalid-path, exists }

  // A directory the host opened. Paths are relative to it and cannot escape it.
  resource dir {
    read:   func(path: string) -> result<list<u8>, io-err>;
    create: func(path: string, data: list<u8>) -> result<_, io-err>;     // a new file only
    %list:  func(path: string) -> result<list<string>, io-err>;          // names, sorted; a directory's ends in `/`
    write:  func(path: string, data: list<u8>) -> result<_, io-err>;     // create or replace, atomically
    remove: func(path: string) -> result<_, io-err>;                     // one regular file
    exists: func(path: string) -> result<bool, io-err>;
  }
}

interface net {
  variant http-err { denied, timeout, too-large, status(u16) }

  // A host and method set the operator granted. Rechecked on every redirect.
  resource http {
    get: func(path: string) -> result<list<u8>, http-err>;
  }
}

interface web {
  resource incoming {
    method: func() -> string;                 // "GET"
    target: func() -> string;                 // "/path?query" as sent, percent-encoding kept; no scheme, host or fragment
    header-names: func() -> list<string>;     // lowercased, in order
    header-values: func() -> list<string>;
    body: func() -> list<u8>;
  }
  resource outgoing {
    send: func(status: u16, header-names: list<string>, header-values: list<string>, body: list<u8>) -> result<_, web-err>;
  }
  variant web-err { already-sent, invalid }
}

interface kv {
  variant kv-err { too-large, full }

  // A key-value store the host keeps across runs and requests. Keys are 1 to 1,024 bytes.
  resource kv {
    get:    func(key: string) -> result<option<list<u8>>, kv-err>;
    set:    func(key: string, value: list<u8>) -> result<_, kv-err>;
    delete: func(key: string) -> result<_, kv-err>;               // a missing key is not an error
    keys:   func(prefix: string) -> result<list<string>, kv-err>; // sorted by bytes
    // Set `key` to `new` (`none` deletes) only if its value is `old` (`none` = absent), atomically.
    swap:   func(key: string, old: option<list<u8>>, new: option<list<u8>>) -> result<bool, kv-err>;
  }
}

world guest {
  import fs;
  import net;
  import web;
  import kv;
  use fs.{dir};
  use net.{http};
  use web.{incoming, outgoing};
  use kv.{kv};

  // A source file: `name` is `web.kio` for `mod web;`; the root comes first.
  record file { name: string, source: string }
  // A checker or runtime error: byte span into source file number `file`, message and an optional fix.
  record diag { start: u32, end: u32, message: string, hint: option<string>, file: u32 }
  // The authority report, one line per function.
  record report { lines: list<string> }
  // What a run produced: the report, main's value printed, and whether main returned `Err`.
  record outcome { report: report, value: string, failed: bool }
  // A grant binds a handle to the `main` parameter of the same name. The guest owns it for one run;
  // `borrow` would be tighter but hits a wit-bindgen 0.63 codegen bug inside a list of records.
  record dir-grant { name: string, dir: dir }
  record http-grant { name: string, http: http }
  record incoming-grant { name: string, incoming: incoming }
  record outgoing-grant { name: string, outgoing: outgoing }
  record kv-grant { name: string, kv: kv }

  // Parse and check. Needs no handles.
  export check: func(files: list<file>) -> result<report, list<diag>>;

  // Check `files` and keep the checked program, for a snapshot taken before any request.
  export init: func(files: list<file>) -> result<_, list<diag>>;

  // Check, then run `main` with each grant bound to its parameter by name; a missing or
  // mistyped grant is an error before any code runs.
  export run: func(files: list<file>, dirs: list<dir-grant>, https: list<http-grant>, incomings: list<incoming-grant>, outgoings: list<outgoing-grant>, kvs: list<kv-grant>) -> result<outcome, list<diag>>;
}

// Compiled kio (docs/codegen.md): the runtime with the program appended, one core module.
world compiled {
  import fs;
  import net;
  import web;
  import kv;
  use fs.{dir};
  use net.{http};
  use web.{incoming, outgoing};
  use kv.{kv};

  // One handle per capability parameter of `main`, in parameter order.
  variant grant { dir(dir), http(http), incoming(incoming), outgoing(outgoing), kv(kv) }
  // main's value printed, and whether main returned `Err`.
  record outcome { value: string, failed: bool }

  // A runtime error at error site `site`, with the values its message shows. Never returns:
  // the host records it and traps.
  import trap: func(site: u32, a: s64, b: s64);

  export run: func(grants: list<grant>) -> result<outcome>;
}
