// The only hand-written declaration of what crosses the sandbox wall.
// The checker's capability table and the guest and host Rust bindings are generated from this file.
// Changing it is a security-review event.

package kio:caps;

interface fs {
  variant io-err { not-found, denied, too-large, invalid-path }

  // A directory the host opened. Paths are relative to it and cannot escape it.
  resource dir {
    read:   func(path: string) -> result<list<u8>, io-err>;
    create: func(path: string, data: list<u8>) -> result<_, io-err>;
  }
}

interface net {
  variant http-err { denied, timeout, too-large, status(u16) }

  // A host and method set the operator granted. Rechecked on every redirect.
  resource http {
    get: func(path: string) -> result<list<u8>, http-err>;
  }
}

interface web {
  resource incoming {
    method: func() -> string;                 // "GET"
    target: func() -> string;                 // raw "/path?query", as sent
    header-names: func() -> list<string>;     // lowercased, in order
    header-values: func() -> list<string>;
    body: func() -> list<u8>;
  }
  resource outgoing {
    send: func(status: u16, header-names: list<string>, header-values: list<string>, body: list<u8>) -> result<_, web-err>;
  }
  variant web-err { already-sent, invalid }
}

world guest {
  import fs;
  import net;
  import web;
  use fs.{dir};
  use net.{http};
  use web.{incoming, outgoing};

  // A checker or runtime error: byte span into the source, message and an optional fix.
  record diag { start: u32, end: u32, message: string, hint: option<string> }
  // The authority report, one line per function.
  record report { lines: list<string> }
  // What a run produced: the report, main's value printed, and whether main returned `Err`.
  record outcome { report: report, value: string, failed: bool }
  // A grant binds a handle to the `main` parameter of the same name. The guest owns it for one run;
  // `borrow` would be tighter but hits a wit-bindgen 0.63 codegen bug inside a list of records.
  record dir-grant { name: string, dir: dir }
  record http-grant { name: string, http: http }
  record incoming-grant { name: string, incoming: incoming }
  record outgoing-grant { name: string, outgoing: outgoing }

  // Parse and check. Needs no handles.
  export check: func(source: string) -> result<report, list<diag>>;

  // Check, then run `main` with each grant bound to its parameter by name; a missing or
  // mistyped grant is an error before any code runs.
  export run: func(source: string, dirs: list<dir-grant>, https: list<http-grant>, incomings: list<incoming-grant>, outgoings: list<outgoing-grant>) -> result<outcome, list<diag>>;
}
