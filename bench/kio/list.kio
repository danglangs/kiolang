// 1 M push, sort, sum by index and by `for`.
fn main() -> Int {
    let n = 1000000;
    let mut xs: List<Int> = [];
    let mut x = 12345;
    for i in 0..n {
        x = (x * 1103515245 + 12345 + i) % 2147483648;
        xs.push(x);
    }
    xs.sort();
    let mut a = 0;
    for i in 0..xs.len() {
        a = a + xs[i] % 1000;
    }
    let mut b = 0;
    for v in xs {
        b = b + v % 7;
    }
    a + b + xs[n / 2]
}
