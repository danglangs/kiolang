// Parse and encode 1 MB of JSON (data/data.json) with kio-web's json.kio, which run.sh copies
// beside this file in bench/build/kio/.
mod json;

fn main(data: Dir) -> Int {
    let text = match data.read("data.json") {
        Ok(b) => b.to_str(),
        Err(_) => return -1,
    };
    match json::parse(text) {
        Ok(j) => json::encode(j).len(),
        Err(_) => -2,
    }
}
