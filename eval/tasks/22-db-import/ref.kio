enum Failed { Io(IoErr), Db(DbErr) }

const SCHEMA: Str = "CREATE TABLE IF NOT EXISTS orders (id INTEGER PRIMARY KEY, customer TEXT, product TEXT, qty INTEGER, unit_cents INTEGER)";
const TOP: Str = "SELECT product, SUM(qty * unit_cents) AS r, COUNT(*) FROM orders GROUP BY product ORDER BY r DESC, product LIMIT 3";

fn db<T>(r: Result<T, DbErr>) -> Result<T, Failed> { r.map_err(|e| Failed::Db(e)) }

fn show(v: SqlValue) -> Str {
  match v { SqlValue::Int(n) => n.to_str(), SqlValue::Text(s) => s, _ => "?" }
}

fn main(input: Dir, shop: Db) -> Result<Str, Failed> {
  let lines = input.read("orders.csv").map_err(|e| Failed::Io(e))?.to_str().lines();
  db(shop.exec(SCHEMA, []))?;
  let mut imported = 0;
  let mut skipped = 0;
  let mut rejected = 0;
  for i in 1..lines.len() {
    if lines[i].trim() == "" { continue; }
    let f = lines[i].split(",").map(|s| s.trim());
    if f.len() != 5 { rejected += 1; continue; }
    let Some(id) = f[0].parse_int() else { rejected += 1; continue; };
    let Some(qty) = f[3].parse_int() else { rejected += 1; continue; };
    let Some(cents) = f[4].parse_int() else { rejected += 1; continue; };
    let n = db(shop.exec("INSERT OR IGNORE INTO orders VALUES (?, ?, ?, ?, ?)",
      [SqlValue::Int(id), SqlValue::Text(f[1]), SqlValue::Text(f[2]), SqlValue::Int(qty), SqlValue::Int(cents)]))?;
    if n == 1 { imported += 1; } else { skipped += 1; }
  }
  let mut out = ["imported " + imported.to_str() + " skipped " + skipped.to_str() + " rejected " + rejected.to_str()];
  for row in db(shop.query(TOP, []))? { out.push(row.map(show).join(" ")); }
  Ok(out.join("\n"))
}
