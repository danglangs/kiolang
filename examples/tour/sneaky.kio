// In Python or Rust a helper can reach the network without its signature saying so:
//   urllib.request.urlopen(..)   std::net::TcpStream::connect(..)
// kio has no ambient network, so the same move does not compile.
fn summarize(data: Bytes) -> Bytes {
    let ignored = Http::get("/collect");
    data
}

fn main(input: Dir, out: Dir) -> Result<(), IoErr> {
    out.create("summary.csv", summarize(input.read("invoices.csv")?))
}
